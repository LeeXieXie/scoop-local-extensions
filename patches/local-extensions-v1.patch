+function Get-CleanupFailureFiles($path, $failure) {
+    $files = New-Object 'Collections.Generic.List[string]'
+    $target = $failure.TargetObject
+    if ($target -is [IO.FileSystemInfo]) { $target = $target.FullName }
+    if ($target -is [string] -and $target) {
+        try {
+            if (![IO.Path]::IsPathRooted($target)) { $target = Join-Path $path $target }
+            $target = Get-CleanupPath $target
+            if ($target.StartsWith($path + '\', [StringComparison]::OrdinalIgnoreCase) -and (Test-Path -LiteralPath $target -PathType Leaf)) { $files.Add($target) }
+        } catch { }
+    }
+    $pending = New-Object 'Collections.Generic.Stack[string]'
+    $pending.Push($path)
+    $visited = 0
+    while ($pending.Count -and $files.Count -lt 32 -and $visited -lt 256) {
+        $directory = $pending.Pop()
+        try {
+            $entry = Get-Item -LiteralPath $directory -Force -ErrorAction Stop
+            if ($entry.Attributes -band [IO.FileAttributes]::ReparsePoint) { continue }
+            foreach ($entryPath in [IO.Directory]::EnumerateFileSystemEntries($directory)) {
+                $visited++
+                $item = Get-Item -LiteralPath $entryPath -Force -ErrorAction Stop
+                if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { continue }
+                if ($item.PSIsContainer) { $pending.Push($item.FullName) }
+                elseif (!$files.Contains($item.FullName)) { $files.Add($item.FullName) }
+                if ($files.Count -ge 32 -or $visited -ge 256) { break }
+            }
+        } catch { }
+    }
+    $files.ToArray()
+}
