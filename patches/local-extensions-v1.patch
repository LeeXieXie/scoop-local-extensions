+function Get-CleanupRestartManagerOwners($files) {
+    if (!('ScoopCleanup.Native.RestartManager' -as [type])) {
+        Add-Type -ErrorAction Stop -TypeDefinition @'
+using System;
+using System.ComponentModel;
+using System.Runtime.InteropServices;
+using System.Text;
+namespace ScoopCleanup.Native {
+    public sealed class Owner {
+        public int ProcessId;
+        public long StartTime;
+        public string AppName;
+        public string ServiceName;
+        public int AppType;
+    }
+    public static class RestartManager {
+        [StructLayout(LayoutKind.Sequential)]
+        private struct UniqueProcess { public uint ProcessId; public System.Runtime.InteropServices.ComTypes.FILETIME StartTime; }
+        [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
+        private struct ProcessInfo {
+            public UniqueProcess Process;
+            [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 256)] public string AppName;
+            [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 64)] public string ServiceName;
+            public int AppType;
+            public uint AppStatus;
+            public uint SessionId;
+            [MarshalAs(UnmanagedType.Bool)] public bool Restartable;
+        }
+        [DllImport("rstrtmgr.dll", CharSet = CharSet.Unicode)]
+        private static extern int RmStartSession(out uint handle, uint flags, StringBuilder key);
+        [DllImport("rstrtmgr.dll", CharSet = CharSet.Unicode)]
+        private static extern int RmRegisterResources(uint handle, uint fileCount, string[] files,
+            uint processCount, UniqueProcess[] processes, uint serviceCount, string[] services);
+        [DllImport("rstrtmgr.dll", CharSet = CharSet.Unicode)]
+        private static extern int RmGetList(uint handle, out uint needed, ref uint count,
+            [In, Out] ProcessInfo[] processes, ref uint reasons);
+        [DllImport("rstrtmgr.dll")]
+        private static extern int RmEndSession(uint handle);
+        private static void Check(int code) {
+            if (code != 0) throw new Win32Exception(code, "Restart Manager error " + code + ": " + new Win32Exception(code).Message);
+        }
+        public static Owner[] FindOwners(string[] files) {
+            uint handle;
+            Check(RmStartSession(out handle, 0, new StringBuilder(33)));
+            try {
+                Check(RmRegisterResources(handle, (uint)files.Length, files, 0, null, 0, null));
+                uint needed, count = 0, reasons = 0;
+                int code = RmGetList(handle, out needed, ref count, null, ref reasons);
+                if (code == 0) return new Owner[0];
+                if (code != 234) Check(code);
+                for (int attempt = 0; attempt < 2; attempt++) {
+                    if (needed > 256) throw new InvalidOperationException("Restart Manager owner limit exceeded (256).");
+                    ProcessInfo[] entries = new ProcessInfo[needed];
+                    count = needed;
+                    code = RmGetList(handle, out needed, ref count, entries, ref reasons);
+                    if (code == 234) continue;
+                    Check(code);
+                    Owner[] owners = new Owner[count];
+                    for (int index = 0; index < count; index++) {
+                        ProcessInfo entry = entries[index];
+                        owners[index] = new Owner {
+                            ProcessId = (int)entry.Process.ProcessId,
+                            StartTime = ((long)(uint)entry.Process.StartTime.dwHighDateTime << 32) | (uint)entry.Process.StartTime.dwLowDateTime,
+                            AppName = entry.AppName, ServiceName = entry.ServiceName, AppType = entry.AppType
+                        };
+                    }
+                    return owners;
+                }
+                Check(code);
+                return new Owner[0];
+            } finally { RmEndSession(handle); }
+        }
+    }
+}
+'@ | Out-Null
+    }
+    [ScoopCleanup.Native.RestartManager]::FindOwners([string[]]$files)
+}
