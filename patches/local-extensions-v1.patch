+function Get-CleanupPath($path) {
+    if (![IO.Path]::IsPathRooted($path)) { throw "Cleanup requires an absolute filesystem path: $path" }
+    [IO.Path]::GetFullPath($path).TrimEnd('\', '/')
+}
+
+function Assert-CleanupVersionPath($dir, $appDir, $currentVersion) {
+    $path = Get-CleanupPath $dir
+    $parent = Get-CleanupPath $appDir
+    if ((Split-Path $path -Parent) -ne $parent -or (Split-Path $path -Leaf) -eq 'current' -or
+        !$currentVersion -or (Split-Path $path -Leaf) -eq $currentVersion) {
+        throw "Refusing unsafe or current version path: $path"
+    }
+    $ancestor = $path
+    while ($ancestor) {
+        $item = Get-Item -LiteralPath $ancestor -Force -ErrorAction Stop
+        if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Refusing a version path through a link: $ancestor" }
+        $ancestor = Split-Path $ancestor -Parent
+    }
+    $current = Get-Item -LiteralPath (Join-Path $parent 'current') -Force -ErrorAction SilentlyContinue
+    for ($depth = 0; $current -and ($current.Attributes -band [IO.FileAttributes]::ReparsePoint); $depth++) {
+        if ($depth -ge 32 -or !$current.Target -or @($current.Target).Count -ne 1) { throw 'Cannot safely resolve the current version link.' }
+        $target = [string]@($current.Target)[0]
+        if (![IO.Path]::IsPathRooted($target)) { $target = Join-Path (Split-Path $current.FullName -Parent) $target }
+        $target = Get-CleanupPath $target
+        if ($path -eq $target) { throw "Refusing the current link target: $path" }
+        $ancestor = Split-Path $target -Parent
+        while ($ancestor) {
+            $item = Get-Item -LiteralPath $ancestor -Force -ErrorAction Stop
+            if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw "Cannot safely resolve the current target through a parent link: $ancestor" }
+            $ancestor = Split-Path $ancestor -Parent
+        }
+        $current = Get-Item -LiteralPath $target -Force -ErrorAction Stop
+    }
+    $path
+}
+
+function Unlink-CleanupData($manifest, $dir) {
+    foreach ($definition in @($manifest.persist)) {
+        if (!$definition) { continue }
+        $source, $null = persist_def $definition
+        $persistPath = Get-CleanupPath (Join-Path $dir $source)
+        if (!$persistPath.StartsWith($dir + '\', [StringComparison]::OrdinalIgnoreCase) -or
+            [Management.Automation.WildcardPattern]::ContainsWildcardCharacters($source)) {
+            throw "Refusing unsafe persist path: $source"
+        }
+        $persistItem = Get-Item -LiteralPath $persistPath -Force -ErrorAction SilentlyContinue
+        if ($persistItem -and !$persistItem.PSIsContainer -and ($persistItem.Attributes -band [IO.FileAttributes]::ReadOnly)) {
+            throw "Refusing to clear a potentially shared read-only persisted file attribute: $persistPath"
+        }
+    }
+    $pending = New-Object 'Collections.Generic.Stack[string]'
+    $pending.Push($dir)
+    while ($pending.Count) {
+        foreach ($item in Get-ChildItem -LiteralPath $pending.Pop() -Force -ErrorAction Stop) {
+            if (!$item.PSIsContainer) {
+                if ($item.LinkType -eq 'HardLink' -and ($item.Attributes -band [IO.FileAttributes]::ReadOnly)) {
+                    throw "Refusing to clear the shared read-only attribute of a hardlinked file: $($item.FullName)"
+                }
+                continue
+            }
+            if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {
+                if ($item.Attributes -band [IO.FileAttributes]::ReadOnly) {
+                    attrib -R /L $item.FullName
+                    if ($LASTEXITCODE) { throw "Cannot clear the junction's read-only attribute: $($item.FullName)" }
+                }
+                [IO.Directory]::Delete($item.FullName)
+            } else {
+                $pending.Push($item.FullName)
+            }
+        }
+    }
+    unlink_persist_data $manifest $dir
+}
