+function Write-CleanupOwner($owner) {
+    $name = $owner.AppName
+    $executable = 'unavailable'
+    $validated = $false
+    try {
+        $process = Get-Process -Id $owner.ProcessId -ErrorAction Stop
+        if ($process.StartTime.ToFileTimeUtc() -eq $owner.StartTime) {
+            $validated = $true
+            $name = $process.ProcessName
+            try { if ($process.Path) { $executable = $process.Path } } catch { }
+        }
+    } catch { }
+    warn "Possible owner via Restart Manager: PID $($owner.ProcessId); Process: $name; Executable: $executable; Application: $($owner.AppName); Service: $($owner.ServiceName)."
+    if (!$validated) {
+        warn 'The PID/start time could not be verified (the process may have exited or the PID may have been reused); no termination command is suggested.'
+    } elseif ($owner.ServiceName -or $owner.AppType -in @(3, 1000) -or $name -in @('System', 'Idle', 'Registry', 'Secure System', 'smss', 'csrss', 'wininit', 'winlogon', 'lsass', 'services', 'svchost')) {
+        warn 'This is a service or critical system process. No termination command is suggested; use the application/service management UI if appropriate.'
+    } else {
+        if ($owner.AppType -eq 4 -or $name -eq 'explorer') { warn 'Explorer provides the desktop and taskbar; stopping it interrupts the desktop session.' }
+        warn "Save work and close the application normally first. Optional manual command (not executed; re-check the PID before use): Stop-Process -Id $($owner.ProcessId)"
+    }
+}
+
+function Write-CleanupFailure($app, $version, $path, $failure, $inspectOwners = $false) {
+    $script:cleanupFailures++
+    warn "Cleanup failed for $app ($version), path '$path': $($failure.Exception.Message)"
+    if (!$inspectOwners) { return }
+    $files = @(Get-CleanupFailureFiles $path $failure)
+    $reason = 'No readable remaining files were found within the bounded scan (32 files / 256 entries).'
+    if ($files.Count) {
+        try {
+            $nativeOwners = @(Get-CleanupRestartManagerOwners $files)
+            if ($nativeOwners.Count) {
+                foreach ($owner in $nativeOwners) { Write-CleanupOwner $owner }
+                return
+            }
+            $reason = "Restart Manager returned no owners for $($files.Count) file(s)."
+        } catch { $reason = $_.Exception.Message }
+    }
+    $owners = @()
+    $timer = [Diagnostics.Stopwatch]::StartNew()
+    $inspected = 0
+    try {
+        foreach ($process in Get-Process -ErrorAction Stop) {
+            if ($inspected -ge 128 -or $timer.ElapsedMilliseconds -ge 2000) { break }
+            $inspected++
+            try {
+                foreach ($module in $process.Modules) {
+                    if ($timer.ElapsedMilliseconds -ge 2000) { break }
+                    if ($module.FileName.StartsWith($path + '\', [StringComparison]::OrdinalIgnoreCase)) {
+                        $executable = 'unavailable'
+                        try { if ($process.Path) { $executable = $process.Path } } catch { }
+                        $owners += "$($process.ProcessName) (PID $($process.Id)); Executable: $executable"
+                        break
+                    }
+                }
+            } catch { }
+        }
+    } catch { }
+    warn "Exact file owner unknown: $reason File locks, permissions, or other errors may prevent deletion."
+    if ($owners) { warn "Possible owners via loaded modules (not proof of a lock; no kill advice): $($owners -join ', ')" }
+}
