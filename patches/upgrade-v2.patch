+        if ($identity -cne $Prepared.Identity) { throw 'Prepared manifest or source identity changed.' }
+    }
+}
+
+function Get-ScoopRestartPrimaryExecutable($Manifest, $Architecture) {
+    foreach ($shortcut in @(arch_specific 'shortcuts' $Manifest $Architecture)) {
+        if (!$shortcut -or $shortcut -is [string] -or $shortcut.Count -lt 2) { continue }
+        $relative = [string]$shortcut[0]
+        $relative = $relative -replace '^\$(?:dir|original_dir)[\\/]', ''
+        if (!$relative -or [IO.Path]::IsPathRooted($relative) -or $relative -match '[$%:\x00-\x1f]|(^|[\\/])\.\.([\\/]|$)' -or [IO.Path]::GetExtension($relative) -ne '.exe') { continue }
+        $relative.Replace('/', '\')
+    }
+}
+function Get-ScoopRestartCandidate($Process, $Root) {
+    if (!$script:ScoopRestartPrimaryExecutables) { return }
+    if (!$Process.Path -or !$Process.MainWindowHandle -or $Process.Id -le 4 -or $Process.Id -eq $PID) { return }
+    if ($Process.PSObject.Properties['SessionId'] -and $Process.SessionId -eq 0) { return }
+    if ($Process.PSObject.Properties['IsCritical'] -and $Process.IsCritical) { return }
+    $excluded = '^(pwsh|powershell|cmd|conhost|openconsole|windowsterminal|wt|explorer|services|svchost|lsass|winlogon|csrss|smss|wininit|dwm|sihost|scoop|bash|wsl|mintty|ssh|sshd|terminal|alacritty|wezterm|wezterm-gui|kitty|hyper|tabby|warp|rio|contour|cmder|conemu|conemu64|conemuc|conemuc64|console2|consolez|git-bash|git-cmd|putty|mobaxterm|securecrt|nu|fish|zsh|sh)(\.exe)?$'
+    if ($Process.ProcessName -match $excluded -or [IO.Path]::GetFileNameWithoutExtension($Process.Path) -match $excluded) { return }
+    $prefix = [IO.Path]::GetFullPath($Root).TrimEnd('\', '/') + '\'
+    $path = [IO.Path]::GetFullPath($Process.Path)
+    if (!$path.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase) -or [IO.Path]::GetExtension($path) -ne '.exe') { return }
+    if ($env:WINDIR -and $path.StartsWith(([IO.Path]::GetFullPath($env:WINDIR).TrimEnd('\') + '\'), [StringComparison]::OrdinalIgnoreCase)) { return }
+    try {
+        $ancestors = @($PID)
+        $parent = $PID
+        while ($parent -gt 0) {
+            $record = Get-CimInstance Win32_Process -Filter "ProcessId=$parent" -ErrorAction Stop
+            $parent = [int]$record.ParentProcessId
+            if ($ancestors -contains $parent) { break }
+            $ancestors += $parent
+        }
+        if ($ancestors -contains $Process.Id) { return }
+        if (@(Get-CimInstance Win32_Service -Filter "ProcessId=$($Process.Id)" -ErrorAction Stop).Count) { return }
+        $current = Join-Path $Root 'current'
+        $currentPrefix = [IO.Path]::GetFullPath($current).TrimEnd('\') + '\'
+        if ($path.StartsWith($currentPrefix, [StringComparison]::OrdinalIgnoreCase)) {
+            $relative = $path.Substring($currentPrefix.Length)
+            if ($script:ScoopRestartPrimaryExecutables -contains $relative) { return $relative }
+            return
+        }
+        $currentItem = Get-Item -LiteralPath $current -ErrorAction Stop
+        $physicalRoot = @($currentItem.Target)[0]
+        if (!$physicalRoot) { return }
+        if (![IO.Path]::IsPathRooted($physicalRoot)) { $physicalRoot = Join-Path $Root $physicalRoot }
+        $physicalPrefix = [IO.Path]::GetFullPath($physicalRoot).TrimEnd('\') + '\'
+        if (!$physicalPrefix.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) { return }
+        if ($path.StartsWith($physicalPrefix, [StringComparison]::OrdinalIgnoreCase)) {
+            $relative = $path.Substring($physicalPrefix.Length)
+            if ($script:ScoopRestartPrimaryExecutables -contains $relative) { return $relative }
+        }
+    } catch { return }
+}
+
+function Invoke-ScoopPreparedRestart($Entry, $Global, $Executables) {
+    $installedVersion = Select-CurrentVersion -AppName $Entry.App -Global:$Global
+    $installedManifest = installed_manifest $Entry.App $installedVersion $Global
+    if ($installedVersion -ne $Entry.Version -or $installedManifest.version -ne $Entry.Version) { throw 'Updated installation could not be verified for relaunch.' }
+    $root = [IO.Path]::GetFullPath((versiondir $Entry.App $Entry.Version $Global)).TrimEnd('\')
+    $launchedExecutables = @{}
+    foreach ($relative in $Executables) {
+        if ($launchedExecutables.ContainsKey($relative)) { continue }
+        $launchedExecutables[$relative] = $true
+        $path = [IO.Path]::GetFullPath((Join-Path $root $relative))
+        if (!$path.StartsWith(($root + '\'), [StringComparison]::OrdinalIgnoreCase)) { throw 'Relaunch target escaped the new installation.' }
+        $cursor = $path
+        while ($cursor) {
+            $item = Get-Item -LiteralPath $cursor -Force -ErrorAction Stop
+            if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Relaunch through reparse points is not permitted.' }
+            $parentPath = Split-Path $cursor -Parent
+            if ($parentPath -eq $cursor) { break }
+            $cursor = $parentPath
+        }
+        if (!(Test-Path -LiteralPath $path -PathType Leaf)) { throw 'Relaunch executable is missing.' }
+        try { Start-Process -FilePath $path -WindowStyle Hidden -ErrorAction Stop | Out-Null }
+        catch { warn "Update succeeded but relaunch failed: $_"; throw }
+    }
+}
