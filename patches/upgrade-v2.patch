+            if ((Get-FileHash -LiteralPath $destination -Algorithm $algorithm -ErrorAction Stop).Hash -ne $expected) { throw 'Offline copied payload hash mismatch.' }
+        }
+        return @($payloads | ForEach-Object { $_.Name })
+    }
     # we only want to show this warning once
     if (!$use_cache) { warn 'Cache is being ignored.' }
 
