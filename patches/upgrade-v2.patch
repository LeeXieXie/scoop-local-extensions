+function Assert-ScoopPreparedPayload($Entry) {
+    Assert-ScoopPreparedEntry $Entry
+    if ($Entry.Offline) { Assert-ScoopOfflineManifest $Entry.Manifest $Entry.Architecture }
+    return Assert-ScoopCachedPayload $Entry.App $Entry.Version $Entry.Manifest $Entry.Architecture
+}
+function Assert-ScoopPreparedEntry($Prepared) {
+    if (!$Prepared.App -or !$Prepared.Manifest -or !$Prepared.Version -or !$Prepared.Architecture) { throw 'Incomplete prepared installation.' }
+    if ($Prepared.Version -ne $Prepared.Manifest.version -or $Prepared.Version -eq 'nightly') { throw 'Prepared version identity changed.' }
+    if ($Prepared.Identity) {
