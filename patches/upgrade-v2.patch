 # Description: Functions for downloading files
 
+function Assert-ScoopOfflinePhysicalPath($Path, $Root) {
+    $full = [IO.Path]::GetFullPath($Path)
+    if ($full.StartsWith('\\') -or $full -match '^\\\\\?\\|^[^:]+::') { throw 'Offline paths must be local physical paths.' }
+    if ($Root) {
+        $base = [IO.Path]::GetFullPath($Root).TrimEnd('\', '/') + [IO.Path]::DirectorySeparatorChar
+        if (!$full.StartsWith($base, [StringComparison]::OrdinalIgnoreCase)) { throw 'Offline path escapes its root.' }
+    }
+    if ($full.Substring([IO.Path]::GetPathRoot($full).Length).Contains(':')) { throw 'Offline paths cannot use alternate data streams.' }
+    if ((New-Object IO.DriveInfo ([IO.Path]::GetPathRoot($full))).DriveType -eq [IO.DriveType]::Network) { throw 'Offline paths cannot use network drives.' }
+    $item = Get-Item -LiteralPath $full -Force -ErrorAction Stop
+    $cursor = $item
+    while ($cursor) {
+        if ($cursor.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Offline paths cannot traverse reparse points.' }
+        if ($cursor.PSObject.Properties['LinkType'] -and $cursor.LinkType) { throw 'Offline paths cannot be links.' }
+        $cursor = if ($cursor -is [IO.DirectoryInfo]) { $cursor.Parent } else { $cursor.Directory }
+    }
+    return $item
+}
+
+function Assert-ScoopOfflineInput($Spec) {
+    if (!$Spec -or $Spec -match '[@&]|(^|[\\/])\.\.([\\/]|$)|^\\\\|^[a-z]+://' -or $Spec -match '[\[\]*?]') {
+        throw "Unsupported offline manifest input '$Spec'."
+    }
+    if ($Spec -match '^(?:[a-zA-Z0-9_-][a-zA-Z0-9_.-]*/)?[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$' -and !$Spec.EndsWith('.json')) { return }
+    if (!$Spec.EndsWith('.json', [StringComparison]::OrdinalIgnoreCase)) { throw 'Offline inputs must be bucket names or local JSON files.' }
+    $item = Assert-ScoopOfflinePhysicalPath $Spec
+    if ($item.PSIsContainer) { throw 'Offline manifest must be a file.' }
+}
+
+function Assert-ScoopOfflineManifest($Manifest, $Architecture, $AllowScripts = $false) {
+    if (!$Manifest -or !$Manifest.version -or $Manifest.version -match 'nightly|[^\w.\-+]|\.$|^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\.|$)' ) { throw 'Offline manifests require a fixed safe version.' }
+    $sections = @($Manifest)
+    if ($Manifest.architecture) { $sections += @($Manifest.architecture.PSObject.Properties | ForEach-Object { $_.Value }) }
+    foreach ($section in $sections) {
+        foreach ($field in @('pre_install', 'post_install', 'pre_uninstall', 'post_uninstall', 'installer', 'uninstaller', 'msi', 'env_set')) {
+            if (!$AllowScripts -and $null -ne $section.$field) { throw "Offline manifests cannot contain '$field'." }
+        }
+    }
+    $urls = @(script:url $Manifest $Architecture)
+    if (!$urls.Count) { throw 'Offline manifests require payload URLs.' }
+    $names = @{}
+    foreach ($url in $urls) {
+        $name = url_filename $url
+        if (!$AllowScripts -and $name -match '(?i)\.msi$') { throw 'Offline MSI extraction is not supported.' }
+        if ($name -and ($name -ne $name.Trim() -or $name.EndsWith('.') -or $name.IndexOfAny([IO.Path]::GetInvalidFileNameChars()) -ge 0 -or $name -match '^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9]|CONIN\$|CONOUT\$)(\.|$)')) { throw 'Unsafe Windows payload filename.' }
+        if (!$name -or [IO.Path]::GetFileName($name) -ne $name -or $name -match '[:\\/]|^\.{1,2}$|(?i)\.(aria2|download|tmp|part)$' -or $names.ContainsKey($name)) { throw 'Unsafe or duplicate offline payload filename.' }
+        $names[$name] = $true
+        $hash = hash_for_url $Manifest $url $Architecture
+        if ($hash -notmatch '^(?:(md5):[a-fA-F0-9]{32}|(sha1):[a-fA-F0-9]{40}|(?:sha256:)?[a-fA-F0-9]{64}|sha512:[a-fA-F0-9]{128})$') { throw 'Offline payloads require explicit supported hashes.' }
+    }
+}
+
+function Assert-ScoopCachedPayload($App, $Version, $Manifest, $Architecture) {
+    if ($Version -ne $Manifest.version) { throw 'Cached payload version differs from its manifest.' }
+    if ($App -notmatch '^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$' -or $Version -match '[^\w.\-+]') { throw 'Invalid cached payload identity.' }
+    if (Test-Path -LiteralPath (Join-Path $cachedir ($App + '.txt'))) { throw 'Incomplete aria2 application download.' }
+    Assert-ScoopOfflineManifest $Manifest $Architecture $true
+    foreach ($url in @(script:url $Manifest $Architecture)) {
+        $cached = cache_path $App $Version $url
+        $item = Assert-ScoopOfflinePhysicalPath $cached $cachedir
+        if ($item.PSIsContainer -or $item.Name -match '(?i)\.aria2$|\.download$|\.tmp$|\.part$' -or (Test-Path -LiteralPath ($cached + '.aria2')) -or (Test-Path -LiteralPath ($cached + '.download')) -or (Test-Path -LiteralPath ($cached + '.tmp')) -or (Test-Path -LiteralPath ($cached + '.part'))) { throw "Incomplete offline cache for '$App'." }
+        $hash = hash_for_url $Manifest $url $Architecture
+        if ($hash -notmatch '^(?:md5:[a-fA-F0-9]{32}|sha1:[a-fA-F0-9]{40}|(?:sha256:)?[a-fA-F0-9]{64}|sha512:[a-fA-F0-9]{128})$') { throw 'Cached payloads require explicit supported hashes.' }
+        $algorithm, $expected = get_hash $hash
+        $actual = (Get-FileHash -LiteralPath $item.FullName -Algorithm $algorithm -ErrorAction Stop).Hash
+        if ($actual -ne $expected) { throw "Offline cache hash mismatch for '$App'." }
+        [pscustomobject]@{ Url = $url; Path = $item.FullName; Name = (url_filename $url); Hash = $hash }
+    }
+}
+
+function Get-ScoopOfflineManifestEntry($Spec, $Architecture) {
+    Assert-ScoopOfflineInput $Spec
+    $bucket = $null; $source = $null
+    if ($Spec.EndsWith('.json', [StringComparison]::OrdinalIgnoreCase)) {
+        $source = (Assert-ScoopOfflinePhysicalPath $Spec).FullName
+        $app = [IO.Path]::GetFileNameWithoutExtension($source)
+    } else {
+        $app, $bucket, $unused = parse_app $Spec
+        $candidates = if ($bucket) { @($bucket) } else { @(Get-LocalBucket) }
+        foreach ($candidate in $candidates) {
+            $base = Find-BucketDirectory $candidate
+            $candidatePath = Join-Path $base ($app + '.json')
+            if (Test-Path -LiteralPath $candidatePath -PathType Leaf) {
+                $source = (Assert-ScoopOfflinePhysicalPath $candidatePath $base).FullName
+                $bucket = $candidate
+                break
+            }
+        }
+    }
+    if (!$source) { throw "Offline local manifest missing for '$Spec'." }
+    if ($app -notmatch '^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$') { throw 'Unsafe offline app name.' }
+    $manifest = Get-Content -LiteralPath $source -Raw -Encoding UTF8 -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
+    $manifest = $manifest | ConvertTo-Json -Depth 100 -Compress | ConvertFrom-Json
+    $arch = Get-SupportedArchitecture $manifest $Architecture
+    if (!$arch) { throw "Unsupported offline architecture for '$app'." }
+    $entry = [pscustomobject]@{ App = $app; Spec = $Spec; Manifest = $manifest; Bucket = $bucket; Source = $source; Architecture = $arch; Version = $manifest.version; Offline = $true }
+    $identityText = @($entry.App, $entry.Spec, $entry.Bucket, $entry.Source, $entry.Architecture, $entry.Version, ($entry.Manifest | ConvertTo-Json -Depth 100 -Compress)) -join "`n"
+    $entry | Add-Member -NotePropertyName Identity -NotePropertyValue $identityText
+    return $entry
+}
+
+function Get-ScoopOfflineInstallPlan($Apps, $Architecture, $Global = $false, $Independent = $false) {
+    $entries = New-Object 'System.Collections.Generic.List[object]'
+    $seen = @{}; $visiting = @{}
+    function Resolve-ScoopOfflineEntry($Spec, $Dependency = $false) {
+        $entry = Get-ScoopOfflineManifestEntry $Spec $Architecture
+        $app = $entry.App
+        $source = $entry.Source
+        $manifest = $entry.Manifest
+        $arch = $entry.Architecture
+        Assert-ScoopOfflineManifest $manifest $arch
+        $identity = $source + '|' + $manifest.version
+        if ($seen.ContainsKey($app)) {
+            if ($seen[$app] -ne $identity) { throw "Conflicting offline sources for '$app'." }
+            return
+        }
+        if ($visiting.ContainsKey($app)) { throw "Circular offline dependency '$app'." }
+        $visiting[$app] = $true
+        if ($Independent) {
+            foreach ($helper in @(Get-InstallationHelper $manifest $arch -All)) {
+                if (!(Test-HelperInstalled $helper)) { throw "Offline extraction helper '$helper' is not installed." }
+            }
+        }
+        if (!$Independent) {
+            foreach ($helper in @(Get-InstallationHelper $manifest $arch -All)) {
+                if (!(Test-HelperInstalled $helper)) { Resolve-ScoopOfflineEntry $helper $true }
+            }
+            foreach ($dep in @($manifest.depends)) {
+                if (!$dep) { continue }
+                Assert-ScoopOfflineInput $dep
+                $depApp, $null, $null = parse_app $dep
+                if (!(installed $depApp)) { Resolve-ScoopOfflineEntry $dep $true }
+            }
+        }
+        $payloads = @(Assert-ScoopCachedPayload $app $manifest.version $manifest $arch)
+        $seen[$app] = $identity
+        $visiting.Remove($app)
+        $entry | Add-Member -NotePropertyName Payloads -NotePropertyValue $payloads
+        $entries.Add($entry)
+    }
+    foreach ($spec in $Apps) { Resolve-ScoopOfflineEntry $spec }
+    return $entries.ToArray()
+}
