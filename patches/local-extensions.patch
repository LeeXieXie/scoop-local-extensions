+    if ($Spec -match '^(?:[a-zA-Z0-9_-][a-zA-Z0-9_.-]*/)?[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$' -and !$Spec.EndsWith('.json')) { return }
