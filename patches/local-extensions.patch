+        if ($hash -notmatch '^(?:md5:[a-fA-F0-9]{32}|sha1:[a-fA-F0-9]{40}|(?:sha256:)?[a-fA-F0-9]{64}|sha512:[a-fA-F0-9]{128})$') { throw 'Cached payloads require explicit supported hashes.' }
