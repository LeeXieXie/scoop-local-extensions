+function Get-ScoopOperationLockPath {
+    param([string]$Root)
+    if (!$Root -or ![IO.Path]::IsPathRooted($Root)) { throw 'Operation lock requires an absolute, existing Scoop root.' }
+    $directory = Get-Item -LiteralPath ([IO.Path]::GetFullPath($Root)) -Force -ErrorAction Stop
+    if (!$directory.PSIsContainer -or $directory.PSProvider.Name -ne 'FileSystem') { throw 'Operation lock root must be a physical directory.' }
+    $ancestor = $directory
+    while ($ancestor) {
+        if ($ancestor.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Operation lock refuses redirected Scoop roots.' }
+        if (Test-Path -LiteralPath (Join-Path $ancestor.FullName '.git')) { throw 'Operation lock must be outside a Git worktree.' }
+        $ancestor = $ancestor.Parent
+    }
+    $path = Join-Path $directory.FullName '.scoop-operation.lock'
+    if (Test-Path -LiteralPath $path) {
+        $item = Get-Item -LiteralPath $path -Force -ErrorAction Stop
+        if ($item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Operation lock refuses a redirected lock file.' }
+    }
+    $path
+}
