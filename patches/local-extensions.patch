+function Get-ScoopOfflineManifestEntry($Spec, $Architecture) {
+    Assert-ScoopOfflineInput $Spec
+    $bucket = $null; $source = $null
+    if ($Spec.EndsWith('.json', [StringComparison]::OrdinalIgnoreCase)) {
+        $source = (Assert-ScoopOfflinePhysicalPath $Spec).FullName
+        $app = [IO.Path]::GetFileNameWithoutExtension($source)
