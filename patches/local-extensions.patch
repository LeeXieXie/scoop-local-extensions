+function Test-GitNetworkCommand {
+    param([String[]]$ArgumentList)
+    for ($index = 0; $index -lt $ArgumentList.Count; $index++) {
+        $argument = $ArgumentList[$index]
+        if ($argument -in @('-C', '-c', '--git-dir', '--work-tree', '--namespace', '--config-env', '--super-prefix')) {
+            $index++
+            continue
+        }
+        if ($argument -in @('--help', '-h', '--version', '-v', '--')) { return $false }
+        if ($argument.StartsWith('-')) { continue }
+        return $argument -cin @('clone', 'fetch', 'pull', 'ls-remote')
+    }
+    return $false
+}
+
+function ConvertTo-GitCommandLine {
+    param([String[]]$ArgumentList)
+    $quoted = foreach ($argument in $ArgumentList) {
+        '"' + ([regex]::Replace([regex]::Replace($argument, '(\\*)"', '$1$1\"'), '(\\+)$', '$1$1')) + '"'
+    }
+    return $quoted -join ' '
+}
