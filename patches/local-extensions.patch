+function Get-ScoopOperationScope {
+    param([string]$Command, [string[]]$Arguments)
+    $mutating = $true
+    if (!$Command -or $Command -in @('-h', '--help', '/?', '-v', '--version', 'help', 'list', 'search', 'status', 'info', 'cat', 'prefix', 'which', 'depends', 'export', 'home')) {
+        $mutating = $false
+    } elseif ($Arguments.Count -gt 0 -and $Arguments[0] -in @('-h', '--help', '/?')) {
+        $mutating = $false
+    } else {
+        switch ($Command) {
+            'config' { $mutating = $Arguments.Count -gt 1 -or ($Arguments.Count -gt 0 -and $Arguments[0] -eq 'rm') }
+            'bucket' { $mutating = $Arguments.Count -gt 0 -and $Arguments[0] -notin @('list', 'known') }
+            'cache' { $mutating = $Arguments.Count -gt 0 -and $Arguments[0] -eq 'rm' }
+            'alias' { $mutating = $Arguments.Count -gt 0 -and $Arguments[0] -ne 'list' }
+            'shim' { $mutating = $Arguments.Count -gt 0 -and $Arguments[0] -notin @('list', 'info') }
+        }
+    }
