+    foreach ($argument in $Arguments) {
+        if ($argument -in @('--', '--%')) { break }
+        if ($Command -eq 'cleanup' -and $argument -eq '--dry-run') { $mutating = $false }
+        if ($argument -eq '--global' -or $argument -cmatch '^-[A-Za-z]*g[A-Za-z]*$') { $globalOperation = $true }
+    }
+    $importStream = $null
+    if ($mutating -and $Command -eq 'import' -and $Arguments.Count -gt 0) {
+        if ($Arguments[0] -match '^(ht|f)tps?://|^\\\\') {
+            throw 'Download the Scoopfile to a local file before importing so its operation lock scope can be verified without network access.'
+        }
+        try {
+            $inputPath = (Get-Item -LiteralPath $Arguments[0] -ErrorAction Stop).FullName
+            $importStream = [IO.File]::Open($inputPath, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read)
+            $reader = New-Object IO.StreamReader($importStream, [Text.Encoding]::UTF8, $true, 1024, $true)
+            try { $importData = $reader.ReadToEnd() | ConvertFrom-Json -ErrorAction Stop }
+            finally { $reader.Dispose() }
+            if (!$importData) { throw 'Input file not a valid JSON.' }
+            foreach ($app in $importData.apps) {
+                if ('Global install' -in ($app.Info -split ', ')) { $globalOperation = $true }
+            }
+        } catch {
+            if ($importStream) { $importStream.Dispose() }
+            throw
+        }
+    }
+    [PSCustomObject]@{ Mutating = $mutating; Global = $globalOperation; ImportStream = $importStream }
+}
