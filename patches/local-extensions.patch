+function Assert-ScoopOfflineManifest($Manifest, $Architecture, $AllowScripts = $false) {
+    if (!$Manifest -or !$Manifest.version -or $Manifest.version -match 'nightly|[^\w.\-+]|\.$|^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\.|$)' ) { throw 'Offline manifests require a fixed safe version.' }
