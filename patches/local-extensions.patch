+        IntPtr outputRead = IntPtr.Zero, outputWrite = IntPtr.Zero, errorRead = IntPtr.Zero, errorWrite = IntPtr.Zero;
+        IntPtr input = IntPtr.Zero, list = IntPtr.Zero, handles = IntPtr.Zero, environment = IntPtr.Zero;
