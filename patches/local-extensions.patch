+function Assert-ScoopOfflineInput($Spec) {
+    if (!$Spec -or $Spec -match '[@&]|(^|[\\/])\.\.([\\/]|$)|^\\\\|^[a-z]+://' -or $Spec -match '[\[\]*?]') {
