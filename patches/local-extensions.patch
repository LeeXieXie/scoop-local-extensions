+        Assert-ScoopPreparedEntry $entry
+    }
+    $ordered = New-Object 'System.Collections.Generic.List[object]'
+    $orderedKeys = @{}
+    $ordering = @{}
+    function Add-ScoopOrderedUpdate($Entry) {
+        $key = $Entry.App + '|' + $Entry.Global
