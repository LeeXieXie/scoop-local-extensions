+function Enter-ScoopOperationLock {
+    param(
+        [string]$UserRoot,
+        [string]$GlobalRoot,
+        [switch]$Global,
+        [string]$Command,
+        [double]$TimeoutSeconds = 30
+    )
+    if ([double]::IsNaN($TimeoutSeconds) -or [double]::IsInfinity($TimeoutSeconds) -or $TimeoutSeconds -lt 0 -or $TimeoutSeconds -gt [int]::MaxValue) {
+        throw 'operation_lock_timeout must be a finite non-negative number of seconds (zero fails fast).'
+    }
+    if (!(Get-Variable ScoopOperationLockState -Scope Global -ErrorAction SilentlyContinue)) { $global:ScoopOperationLockState = @{} }
+    $userPath = Get-ScoopOperationLockPath $UserRoot
+    $paths = @($userPath)
+    if ($Global) {
+        $globalPath = Get-ScoopOperationLockPath $GlobalRoot
+        if ($globalPath -ne $userPath) {
+            if ($global:ScoopOperationLockState.ContainsKey($userPath) -and !$global:ScoopOperationLockState.ContainsKey($globalPath)) {
+                throw 'A nested global Scoop operation cannot upgrade a local lease. Run the global operation separately.'
+            }
+            $paths = @($globalPath, $userPath)
+        }
+    }
+    $acquired = New-Object Collections.ArrayList
+    $clock = [Diagnostics.Stopwatch]::StartNew()
+    $processStart = (Get-Process -Id $PID).StartTime.ToUniversalTime()
+    $marker = "$PID|$($processStart.Ticks)"
+    try {
+        foreach ($path in $paths) {
+            if ($global:ScoopOperationLockState.ContainsKey($path)) {
+                $global:ScoopOperationLockState[$path].Depth++
+                [void]$acquired.Add($path)
+                continue
+            }
+            $stream = $null
+            while (!$stream) {
+                $null = Get-ScoopOperationLockPath (Split-Path $path -Parent)
+                try {
+                    $stream = [IO.File]::Open($path, [IO.FileMode]::OpenOrCreate, [IO.FileAccess]::ReadWrite, [IO.FileShare]::Read)
+                } catch [IO.IOException] {
+                    if (($_.Exception.HResult -band 0xffff) -notin @(32, 33)) { throw }
+                    $owner = Read-ScoopOperationLockOwner $path
+                    $ownerMarker = if ($owner) { "$($owner.pid)|$($owner.start_ticks)" } else { '' }
+                    if ($ownerMarker -and $env:SCOOP_OPERATION_LOCK_PARENT -eq $ownerMarker) {
+                        throw "Nested Scoop process cannot wait for ancestor PID $($owner.pid). Run this command after the outer operation finishes."
+                    }
+                    if ($clock.Elapsed.TotalSeconds -ge $TimeoutSeconds) {
+                        $ownerInfo = if ($owner) { "PID $($owner.pid), started $($owner.start_time), command $($owner.command)" } else { 'owner information unavailable' }
+                        throw "Scoop operation lock timed out: $ownerInfo. Wait for the operation to finish; no process was stopped."
+                    }
+                    $remaining = ($TimeoutSeconds - $clock.Elapsed.TotalSeconds) * 1000
+                    Start-Sleep -Milliseconds ([int][Math]::Max(1, [Math]::Min(100, $remaining)))
+                }
+            }
+            try {
+                Test-ScoopOperationLockHandle $stream $path
+                $safeCommand = if ($Command -match '^[a-zA-Z][a-zA-Z0-9_-]{0,63}$') { $Command } else { 'custom-command' }
+                $metadata = @{ pid = $PID; start_time = $processStart.ToString('o'); start_ticks = $processStart.Ticks; command = $safeCommand } | ConvertTo-Json -Compress
+                $bytes = [Text.Encoding]::UTF8.GetBytes($metadata)
+                $stream.SetLength(0)
+                $stream.Write($bytes, 0, $bytes.Length)
+                $stream.Flush()
+                $global:ScoopOperationLockState[$path] = @{ Stream = $stream; Depth = 1 }
+                [void]$acquired.Add($path)
+            } catch { $stream.Dispose(); throw }
+        }
+        $lease = [PSCustomObject]@{ Paths = @($acquired); PreviousParent = $env:SCOOP_OPERATION_LOCK_PARENT }
+        $env:SCOOP_OPERATION_LOCK_PARENT = $marker
+        $lease
+    } catch {
+        Exit-ScoopOperationLock ([PSCustomObject]@{ Paths = @($acquired); PreviousParent = $env:SCOOP_OPERATION_LOCK_PARENT })
+        throw
+    }
+}
+
+function Exit-ScoopOperationLock {
+    param($Lease)
+    if (!$Lease) { return }
+    for ($index = $Lease.Paths.Count - 1; $index -ge 0; $index--) {
+        $path = $Lease.Paths[$index]
+        $state = $global:ScoopOperationLockState[$path]
+        if ($state) {
+            $state.Depth--
+            if ($state.Depth -eq 0) {
+                $state.Stream.Dispose()
+                $global:ScoopOperationLockState.Remove($path)
+            }
+        }
+    }
+    $env:SCOOP_OPERATION_LOCK_PARENT = $Lease.PreviousParent
+}
