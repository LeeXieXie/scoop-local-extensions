+function Test-ScoopOperationLockHandle {
+    param([IO.FileStream]$Stream, [string]$Path)
+    if (!('ScoopOperationLockNative' -as [type])) {
+        Add-Type -TypeDefinition @'
+using System;
+using System.Runtime.InteropServices;
+using System.Text;
+using Microsoft.Win32.SafeHandles;
+public static class ScoopOperationLockNative {
+    [StructLayout(LayoutKind.Sequential)]
+    public struct Information {
+        public uint Attributes;
+        public System.Runtime.InteropServices.ComTypes.FILETIME Creation, Access, Write;
+        public uint Volume, SizeHigh, SizeLow, Links, IndexHigh, IndexLow;
+    }
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    public static extern uint GetFinalPathNameByHandle(SafeFileHandle handle, StringBuilder path, uint size, uint flags);
+    [DllImport("kernel32.dll", SetLastError = true)]
+    public static extern bool GetFileInformationByHandle(SafeFileHandle handle, out Information information);
+}
+'@ -ErrorAction Stop
+    }
+    $buffer = New-Object Text.StringBuilder 32768
+    $length = [ScoopOperationLockNative]::GetFinalPathNameByHandle($Stream.SafeFileHandle, $buffer, $buffer.Capacity, 0)
+    $information = New-Object ScoopOperationLockNative+Information
+    if (!$length -or $length -ge $buffer.Capacity -or ![ScoopOperationLockNative]::GetFileInformationByHandle($Stream.SafeFileHandle, [ref]$information)) {
+        throw 'Cannot verify the physical operation lock file.'
+    }
+    $physicalPath = $buffer.ToString()
+    if ($physicalPath.StartsWith('\\?\UNC\')) { $physicalPath = '\\' + $physicalPath.Substring(8) }
+    elseif ($physicalPath.StartsWith('\\?\')) { $physicalPath = $physicalPath.Substring(4) }
+    if (![string]::Equals($physicalPath, $Path, [StringComparison]::OrdinalIgnoreCase) -or $information.Links -ne 1) {
+        throw 'Operation lock refuses redirected or hard-linked lock files.'
+    }
+}
