+function Assert-ScoopOfflinePhysicalPath($Path, $Root) {
+    $full = [IO.Path]::GetFullPath($Path)
+    if ($full.StartsWith('\\') -or $full -match '^\\\\\?\\|^[^:]+::') { throw 'Offline paths must be local physical paths.' }
+    if ($Root) {
+        $base = [IO.Path]::GetFullPath($Root).TrimEnd('\', '/') + [IO.Path]::DirectorySeparatorChar
+        if (!$full.StartsWith($base, [StringComparison]::OrdinalIgnoreCase)) { throw 'Offline path escapes its root.' }
+    }
+    if ($full.Substring([IO.Path]::GetPathRoot($full).Length).Contains(':')) { throw 'Offline paths cannot use alternate data streams.' }
+    if ((New-Object IO.DriveInfo ([IO.Path]::GetPathRoot($full))).DriveType -eq [IO.DriveType]::Network) { throw 'Offline paths cannot use network drives.' }
+    $item = Get-Item -LiteralPath $full -Force -ErrorAction Stop
+    $cursor = $item
+    while ($cursor) {
+        if ($cursor.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Offline paths cannot traverse reparse points.' }
+        if ($cursor.PSObject.Properties['LinkType'] -and $cursor.LinkType) { throw 'Offline paths cannot be links.' }
+        $cursor = if ($cursor -is [IO.DirectoryInfo]) { $cursor.Parent } else { $cursor.Directory }
+    }
+    return $item
+}
