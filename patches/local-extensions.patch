+            if (handles != IntPtr.Zero) Marshal.FreeHGlobal(handles);
+            if (environment != IntPtr.Zero) Marshal.FreeHGlobal(environment);
+        }
+    }
+    public void Dispose() {
+        if (StandardOutput != null) StandardOutput.Dispose();
+        if (StandardError != null) StandardError.Dispose();
+        Close(ref process);
+    }
